# 공공데이터포털(data.go.kr) 일반 인증키
# 활용신청 필요: "서울특별시_정류소정보조회 서비스"
SEOUL_BUS_KEY=

# 서울 열린데이터광장(data.seoul.go.kr) "실시간 지하철 인증키"
SEOUL_SUBWAY_KEY=

# 서울 열린데이터광장 일반 인증키 (승하차 통계 분석용 data/bus_boarding.py, 정류장 제보 탭의 사고·통제 = 실시간 돌발정보 AccInfo)
SEOUL_OPENDATA_KEY=

# ODsay 대중교통 길찾기 (lab.odsay.com) · 로컬 개발은 본인 무료(Basic) 키 사용 (팀 배포 키는 유료)
ODSAY_KEY=
# 배포(Vercel)에서는 ODsay에 웹(URI) 방식 키를 등록하고, 등록한 주소를 여기에 (예: https://skip-commute.vercel.app)
ODSAY_REFERER=
# 하루 호출 상한 (비우면 배포 100 / 로컬 30). 배포 키는 유료(건당 25원)라 로컬 개발은 본인 무료(Basic) 키로
ODSAY_DAILY_LIMIT=

# 상세주소 → 좌표 (developers.kakao.com REST API 키, 카카오맵 사용 설정 ON)
KAKAO_REST_KEY=
# 날씨: 비 오면 도보·버스 보정 (data.go.kr 기상청_단기예보 조회서비스)
KMA_KEY=

# 웹 푸시 (실제 휴대폰 알림). 만들기: npx web-push generate-vapid-keys
# 로컬과 Vercel에 같은 값을 넣어야 함 (바꾸면 기존 알림 구독이 전부 무효)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 선택: 알림 발신자 (기본값은 배포 주소)
VAPID_SUBJECT=

# 예약 알림 (Upstash QStash, console.upstash.com → QStash). 없으면 테스트 알림만 동작
# 지역 리전 계정이면 콘솔에 나오는 QSTASH_URL도 같이
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=
