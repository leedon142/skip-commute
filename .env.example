# 공공데이터포털(data.go.kr) 일반 인증키
# 활용신청 필요: "서울특별시_정류소정보조회 서비스"
SEOUL_BUS_KEY=

# 서울 열린데이터광장(data.seoul.go.kr) "실시간 지하철 인증키"
SEOUL_SUBWAY_KEY=

# 서울 열린데이터광장 일반 인증키 (승하차 통계 분석용, data/bus_boarding.py)
SEOUL_OPENDATA_KEY=

# ODsay 대중교통 길찾기 (lab.odsay.com) · 로컬 개발은 본인 무료(Basic) 키 사용 (팀 배포 키는 유료)
ODSAY_KEY=
# 배포(Vercel)에서는 ODsay에 웹(URI) 방식 키를 등록하고, 등록한 주소를 여기에 (예: https://skip-commute.vercel.app)
ODSAY_REFERER=
# 하루 호출 상한 (비우면 배포 100 / 로컬 30). 배포 키는 유료(건당 25원)라 로컬 개발은 본인 무료(Basic) 키로
ODSAY_DAILY_LIMIT=

# 시간표 사진 인식 (aistudio.google.com, 무료)
GEMINI_API_KEY=
# 상세주소 → 좌표 (developers.kakao.com REST API 키, 카카오맵 사용 설정 ON)
KAKAO_REST_KEY=
# 날씨: 비 오면 도보·버스 보정 (data.go.kr 기상청_단기예보 조회서비스)
KMA_KEY=
