{
  "name": "skip-commute",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server.js",
    "css": "tailwindcss -c tailwind.config.cjs -i tailwind.src.css -o vendor/tailwind.css --minify",
    "mobile:build": "node scripts/build-mobile.mjs",
    "mobile:sync": "npm run mobile:build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run mobile:sync && cd android && gradlew.bat assembleDebug",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "mobile:test": "npm run mobile:build && node --test \"mobile-tests/*.test.mjs\""
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@vercel/functions": "^3.10.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@phosphor-icons/web": "^2.1.1",
    "onnxruntime-web": "^1.20.1",
    "pretendard": "^1.3.9",
    "tailwindcss": "^3.4.17"
  }
}
